<UserControl x:Class="CameraWorkStudio.Controls.ScenePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1F29">
    <Grid>
        <Viewport3D x:Name="Viewport" ClipToBounds="True">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="ViewCamera"
                                   Position="600,500,900"
                                   LookDirection="-600,-450,-900"
                                   UpDirection="0,1,0"
                                   FieldOfView="55" />
            </Viewport3D.Camera>

            <ModelVisual3D x:Name="SceneRoot" />
        </Viewport3D>

        <!-- 左上の情報表示 -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                Background="#99101620" CornerRadius="4" Padding="8,5">
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#8FA0B8" FontSize="11" Text="未接続" />
                <TextBlock x:Name="ModeText" Foreground="#5F6C80" FontSize="10" Text="" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 右上の操作ヒント -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                Background="#99101620" CornerRadius="4" Padding="8,5">
            <TextBlock Foreground="#5F6C80" FontSize="10"
                       Text="俯瞰: ドラッグで回転 / ホイールでズーム" />
        </Border>
    </Grid>
</UserControl>
